# Copy to .env and fill in. The project runs WITHOUT any key (rule-based agent policy).
# Never commit .env.

# auto = OpenAI -> NVIDIA -> rules ; or force: openai | nvidia | none
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 1 = never call external APIs, use the committed weather cache only
WINDAGENT_OFFLINE=0
